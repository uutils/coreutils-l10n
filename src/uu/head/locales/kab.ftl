head-about =
    Sken-d 10 n yizirigen imezwura n yal AFAYLU ɣer tuffɣa tamagnut.
    Ma yella ugar n yiwen n UFAYLU, rnu-d uqbel yal yiwen tasenṭit i d-yeskanen isem n ufaylu.
    Ma ulac AFAYLU, neɣ ma AFAYLU d -, ɣeṛ anekcum amagnu.

    Tiɣirtin ilaqen i textiṛin tiɣezfanin ilaqent daɣen i textiṛin tiwezlanin.
head-usage = head [TAXTIṚT]... [AFAYLU]...
head-help-bytes =
    Sken-d AMḌAN n yitamḍanen imezwura n yal afaylu;
    s '-' deg tazwara, sken-d meṛṛa itamḍanen n yal afaylu, anagar
    AMḌAN n yitamḍanen ineggura
head-help-lines =
    Sken-d AMḌAN n yizirigen imezwura deg umḍiq n 10 imezwura;
    s '-' deg tazwara, sken-d meṛṛa izirigen n yal afaylu, anagar
    AMḌAN n yizirigen ineggura
head-help-quiet = Ur skan ara akk tisenṭa i d-yeskanen ismawen n ifuyla
head-help-verbose = Sken-d yal tikelt tisenṭa i d-yeskanen ismawen n ifuyla
head-help-zero-terminated = Anabraz n uzirig d NUL, mačči d izirig amaynut
head-error-reading-file = Tuccḍa deg tɣuri n { $name }: { $err }
head-error-parse-error = Tuccḍa n tesleḍt: { $err }
head-error-num-too-large = Amḍan n yitamḍanen neɣ n yizirigen meqqer aṭas
head-error-clap = Tuccḍa n clap: { $err }
head-error-invalid-bytes = Amḍan n yitamḍanen d armeɣtu: { $err }
head-error-invalid-lines = Amḍan n yizirigen d armeɣtu: { $err }
head-error-bad-argument-format = Amasal n tiɣiret d armeɣtu: { $arg }
head-error-writing-stdout = Tuccḍa deg tira ɣer 'tuffɣa tamagnut': { $err }
head-error-cannot-open = Ur yezmir ara ad yeldi { $name } i tɣuri
head-name-stdin = anekcum amagnu
