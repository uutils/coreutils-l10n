chgrp-about = Ändra grupp för varje FIL till GRUPP.
chgrp-usage =
    chgrp [FLAGGA]... GRUPP FIL...
    chgrp [FLAGGA]... --reference=REFERENSFIL FIL...
chgrp-help-print-help = Skriv ut hjälpinformation.
chgrp-help-verbose = skriv ut ett diagnostiskt meddelande för varje bearbetad fil
chgrp-help-preserve-root = utför inte rekursiva åtgärder på '/'
chgrp-help-changes = som --verbose, men rapportera endast när en ändring görs
chgrp-help-quiet = undertryck de flesta felmeddelanden
chgrp-help-no-preserve-root = behandla inte '/' särskilt (standard)
chgrp-help-reference = använd REFERENSFILENS grupp i stället för angivna GRUPP-värden
chgrp-help-from = ändra grupp endast om den nuvarande gruppen matchar GRUPP
chgrp-help-recursive = arbeta rekursivt med filer och kataloger
chgrp-error-failed-to-get-attributes = misslyckades med att hämta attribut för { $file }
chgrp-error-invalid-user = ogiltig användare: '{ $from_group }'
chgrp-error-invalid-group-id = ogiltigt grupp-ID: '{ $gid_str }'
chgrp-error-invalid-group = ogiltig grupp: '{ $group }'
