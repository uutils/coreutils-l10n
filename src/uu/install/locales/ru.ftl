install-usage = install [ПАРАМЕТР]... [ФАЙЛ]...
install-about =
    Скопировать ИСТОЧНИК в НАЗНАЧ или несколько ИСТОЧНИКОВ в существующий
    КАТАЛОГ, устанавливая права доступа и владельца/группу
install-help-ignored = игнорируется
install-help-compare = сравнивать каждую пару исходного и целевого файлов и в некоторых случаях вообще не изменять целевой файл
install-help-directory = считать все аргументы именами каталогов; создать все компоненты указанных каталогов
install-help-create-leading = создать все начальные компоненты НАЗНАЧ, кроме последнего, затем скопировать ИСТОЧНИК в НАЗНАЧ
install-help-group = установить группу-владельца вместо текущей группы процесса
install-help-mode = установить права доступа (как в chmod) вместо rwxr-xr-x
install-help-owner = установить владельца (только для суперпользователя)
install-help-preserve-timestamps = перенести время доступа/изменения ИСТОЧНИКОВ на соответствующие целевые файлы
install-help-strip = удалить таблицы символов
install-help-strip-program = программа для удаления символов из исполняемых файлов
install-help-preserve-context = сохранять контекст безопасности
install-help-context = установить контекст безопасности файлов и каталогов
install-help-default-context = установить контекст безопасности SELinux целевого файла и каждого создаваемого каталога в тип по умолчанию
install-help-unprivileged = не требовать повышенных прав для изменения владельца, группы или флагов целевого файла
install-error-dir-needs-arg = { $util_name } с -d требует хотя бы одного аргумента.
install-error-create-dir-failed = невозможно создать каталог { $path }
