ptx-about =
    Skapa ett permuterat index över filinnehåll
    Skriv ut ett permuterat index inklusive kontext över orden i indatafilerna.
    Obligatoriska argument för långa flaggor är också obligatoriska för korta flaggor.
    Utan FILE, eller när FILE är -, läs standard in. Standardvärdet är '-F /'.
ptx-usage =
    ptx [OPTION]... [INPUT]...
    ptx -G [OPTION]... [INPUT [OUTPUT]]
ptx-error-extra-operand = extra operand { $operand }
ptx-help-auto-reference = skriv ut automatiskt skapade referenser
ptx-help-traditional = uppför dig mer som System V 'ptx'
ptx-help-flag-truncation = använd STRING för att markera radavkortningar
ptx-help-macro-name = makronamn att använda i stället för 'xx'
ptx-help-roff = skapa utdata som roff direktiv
ptx-help-tex = skapa utdata som TeX direktiv
ptx-help-right-side-refs = placera referenser till höger, de räknas inte i -w
ptx-help-sentence-regexp = för radslut eller meningsslut
ptx-help-word-regexp = använd REGEXP för att matcha varje nyckelord
ptx-help-break-file = ordbrytningstecken i denna FILE
ptx-help-ignore-case = omvandla gemener till versaler för sortering
ptx-help-gap-size = mellanrumsstorlek i kolumner mellan utdatafält
ptx-help-ignore-file = läs lista med ord att ignorera från FILE
ptx-help-only-file = läs lista med enbart ord från denna FILE
ptx-help-references = första fältet på varje rad är en referens
ptx-help-width = utdatabredd i kolumner, referens utesluten
ptx-error-dumb-format = Det finns inget dumt format när GNU tillägg är inaktiverade
ptx-error-not-implemented = { $feature } är ännu inte implementerad
ptx-error-write-failed = skrivningen misslyckades
ptx-help-typeset-mode = ändra standardbredden från 72 till 100
ptx-error-empty-regexp = Ett reguljärt uttryck kan inte matcha en sträng med längden noll
ptx-error-invalid-regexp = Ogiltigt reguljärt uttryck: { $error }
