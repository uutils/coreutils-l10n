cut-error-multiple-mode-args = nomes es pot especificar una llista
cut-error-missing-mode-arg = has d'especificar una llista d'octets, caràcters, o camps
cut-error-field-numbered-from-1 = els camps són numerats des de 1
cut-error-position-numbered-from-1 = les posicions d'octet/caràcter són numerades des de 1
cut-error-invalid-field-range = rang de camp invalid
cut-error-invalid-position-range = rang d'octet o caràcter invalid
cut-error-invalid-decreasing-range = rang decreixent invalid
