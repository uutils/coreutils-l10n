chown-warning-dot-separator = '.' ilaq ad yili ':': { $spec }
chown-help-print-help = Siggez talɣut n tallalt.
chown-about = Snifel bab d ugraw n yifuyla
chown-usage =
    chown [TAXTIṚT]... [BAB][:[AGRAW]] AFAYLU...
    chown [TAXTIṚT]... --reference=AFAYLU-N-TMSELƔUT AFAYLU...
chown-help-changes = Am uskar verbose, maca yeskan-d izen kan mi ara yili usnifel
chown-help-from =
    Snifel bab d/neɣ agraw n yal afaylu kan ma
    bab-is d/neɣ agraw-is amiran mṣadan akked wid i d-yettwabedren dagi.
    Yezmer ad yettwazgel yiwen seg-sen; deg tegnit-a, ur tettwasra ara temṣada
    i yimyerr yettwazglen
chown-help-preserve-root = Yettagi ad ixdem s wudem asnalas ɣef '/'
chown-help-no-preserve-root = Ur sefser ara '/' s wudem uzzig (s wudem amezwer)
chown-help-quiet = Ur d-skan ara tuget n yiznan n tuccḍa
chown-help-recursive = Xdem ɣef yifuyla d yikaramen s wudem asnalas
chown-help-reference = Seqdec bab d ugraw n UFAYLU-N-TMSELƔUT deg umḍiq n ubdar n wazalen BAB:AGRAW
chown-help-verbose = Sken-d izen n usekyed i yal afaylu yettwasefsren
chown-error-failed-to-get-attributes = Ur yezmir ara ad d-yawi imyaren n { $file }
chown-error-invalid-user = Aseqdac d armeɣtu: { $user }
chown-error-invalid-group = Agraw d armeɣtu: { $group }
chown-error-invalid-spec = Asefru d armeɣtu: { $spec }
