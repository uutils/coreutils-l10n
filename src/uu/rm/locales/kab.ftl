rm-progress-removing = Tukksa
rm-usage = rm [OPTION]... AFAYLU...
rm-verbose-removed = { $file } yettwakkes
rm-about = Kkes (senser) AFAYLU (neɣ ifuyla)
rm-after-help =
    S wudem amezwer, rm ur yekkes ara ikaramen. Seqdec taxtiṛt --recursive (-r neɣ -R)
    akken ad tekkseḍ daɣen yal akaram yettwabedren, akked meṛṛa agbur-is

    I tukksa n ufaylu i yebdan yisem-is s '-', am '-foo',
    seqdec yiwet seg tladna-a:
    rm -- -foo

    rm ./-foo

    Ẓer belli ma tseqdceḍ rm i tukksa n ufaylu, yezmer ad yili wamek ara d-terreḍ
    kra seg ugbur-is, ma tesɛiḍ tamusni d wakud iwulmen. Akken ad teḍemneḍ ugar
    belli agbur ur yezmir ara ad d-yuɣal s tidet, wali aseqdec n shred.
rm-help-force = Zgel ifuyla ur yellin ara akked tiɣirtin; Ur yessuter ara asentem uqbel tukksa
rm-help-prompt-always = Yessuter asentem uqbel yal tukksa
rm-help-prompt-once =
    Yessuter asentem yiwet n tikelt uqbel tukksa n ugar n kraḍ n yifuyla, neɣ deg tukksa tasnalast.
    Ur yessuter ara asentem s waṭas am -i, maca yettak amesten mgal tuget n tuccḍiwin
rm-help-interactive =
    Yessuter asentem ilmend n MELMI: never, once (-I), neɣ always (-i). War MELMI,
    yessuter asentem yal tikelt
rm-help-one-file-system =
    Deg tukksa tasnalast n useklu, yezgel yal akaram yellan deg unagraw n ifuyla
    yemgaraden ɣef win n tɣiret n yizirig n tladna i as-icuban (UR
    TETTWAXDEM ARA)
rm-help-no-preserve-root = Ur isefrak ara '/' s wudem uzzig
rm-help-recursive = Kkes ikaramen akked ugbur-nsen s wudem asnalas
rm-help-dir = Kkes ikaramen ilmawen
rm-help-preserve-root = Ur ttekkes ara '/' (s wudem amezwer); s 'all', agi yal tiɣiret n yizirig n tladna yellan deg yibenk yemgaraden ɣef win n ukaram-is ababat
rm-help-verbose = Ssegzi ayen yettwaxedmen
rm-help-progress = beqqeḍ afeggag n usfari. Tamawt: tawuri-a ur tettusefrak ara sɣur GNU coreutils.
rm-error-missing-operand =
    Ixuṣṣ umhil
    Ɛreḍ '{ $util_name } --help' i wugar n telɣut.
rm-hint-dash-file =
    Ɛreḍ '{ $util_name } ./{ $path }' i tukksa n ufaylu { $file }.
    Ɛreḍ '{ $util_name } --help' i wugar n telɣut.
rm-error-cannot-remove-no-such-file = Ur yezmir ara ad yekkes { $file }: Ulac afaylu neɣ akaram s yisem-a
rm-error-cannot-remove-permission-denied = Ur yezmir ara ad yekkes { $file }: Tasiregt tettwagi
rm-error-cannot-remove-is-directory = Ur yezmir ara ad yekkes { $file }: D akaram
rm-error-dangerous-recursive-operation = D amihaw ad txedmeḍ s wudem asnalas ɣef '/'
rm-error-dangerous-recursive-operation-same-as-root = D amihaw ad txedmeḍ s wudem asnalas ɣef '{ $path }' (d agdazal n '/')
rm-error-use-no-preserve-root = Seqdec --no-preserve-root i uzgal n umesten-a
rm-error-refusing-to-remove-directory = Yugi ad yekkes akaram '.' neɣ '..': yezgel { $path }
rm-error-skipping-different-device = Yezgel { $file }, acku yella deg yibenk yemgaraden
rm-error-and-preserve-root-all-in-effect = yerna --preserve-root=all yermed
rm-error-cannot-remove = Ur yezmir ara ad yekkes { $file }
rm-error-cannot-remove-changed = Ur yezmir ara ad yekkes { $file }: Afaylu ibeddel deg wakud n tukksa-s
rm-error-may-not-abbreviate-no-preserve-root = Ur tzemreḍ ara ad teswezzleḍ taxtiṛt --no-preserve-root
rm-error-standard-output = Tuffɣa tamagnut: { $error }
rm-verbose-removed-directory = Yettwakkes ukaram { $file }
