cat-about =
    Sammanfoga FILE(er) eller standard in till standard ut
    När FILE saknas eller är - läser programmet standard in.
cat-usage = cat [OPTION]... [FILE]...
cat-help-show-all = motsvarar -vET
cat-help-number-nonblank = numrera icke tomma utdatarader, åsidosätter -n
cat-help-show-nonprinting-ends = motsvarar -vE
cat-help-show-ends = visa $ i slutet av varje rad
cat-help-number = numrera alla utdatarader
cat-help-squeeze-blank = utelämna upprepade tomma utdatarader
cat-help-show-nonprinting-tabs = motsvarar -vT
cat-help-show-tabs = visa TAB tecken som ^I
cat-help-show-nonprinting = använd ^ och M-notation, förutom för LF (\n) och TAB (\t)
cat-help-ignored-u = (ignoreras)
cat-error-unknown-filetype = okänd filtyp: { $ft_debug }
cat-error-is-directory = Är en katalog
cat-error-input-file-is-output-file = indatafilen är utdatafilen
cat-error-too-many-symbolic-links = För många nivåer av symboliska länkar
cat-error-no-such-device-or-address = Ingen sådan enhet eller adress
