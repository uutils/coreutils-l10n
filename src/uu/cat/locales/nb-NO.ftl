cat-help-number = nummerer alle utdatalinjer
cat-help-squeeze-blank = undertrykk repeterte tomme utdatalinjer
cat-help-show-nonprinting-tabs = ekvivalent med -vT
cat-help-show-tabs = vis TAB-tegn som ^I
