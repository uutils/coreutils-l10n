cat-about =
    Konkatiner FILE(r), eller standard input, til standard output
    Hvis ingen FIL, eller hvis FIL er -, les standard input.
cat-usage = cat [OPTION]... [FILE]...
cat-help-show-all = ekvivalent med -vET
cat-help-number-nonblank = antall ikke-tomme utdatalinjer, overstyrer -n
cat-help-show-nonprinting-ends = ekvivalent med -vE
