uname-label-kernel-version = Wersja jądra: { $value }
uname-label-machine = Urządzenie: { $value }
uname-label-processor = Procesor: { $value }
uname-label-hardware-platform = Platforma sprzętowa: { $value }
uname-label-os = System operacyjny: { $value }
