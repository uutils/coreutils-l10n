uname-about =
    打印当前的系统信息。
    若无选项，则于“-s”相同。
uname-usage = uname [选项]...
uname-error-cannot-get-system-name = 无法获取系统名
uname-unknown = 未知
uname-help-all = 行为类似于使用 -mnrsvo 选项。
uname-help-kernel-name = 输出内核名称。
uname-help-nodename = 输出节点名称（节点名称可能是系统在通信网络中使用的名称）。
uname-help-kernel-release = 输出操作系统发行版。
uname-help-kernel-version = 输出操作系统版本。
uname-help-machine = 输出机器硬件名称。
uname-help-os = 输出操作系统名称。
uname-help-processor = 输出处理器类型（不具有可移植性）
uname-help-hardware-platform = 输出硬件平台（不具有可移植性）
uname-help-all-labeled = 像 -a 一样，打印所有信息，但每行一个项，并带标签。
uname-label-kernel-name = 内核名称：{ $value }
uname-label-nodename = 节点名称：{ $value }
uname-label-kernel-release = 内核发行版：{ $value }
uname-label-kernel-version = 内核版本：{ $value }
uname-label-machine = 机器：{ $value }
uname-label-processor = 处理器：{ $value }
uname-label-hardware-platform = 硬件平台：{ $value }
uname-label-os = 操作系统：{ $value }
