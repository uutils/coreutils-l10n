fold-about =
    Skriv varje fil till standardutdata och bryt långa rader
    om inga filer anges, läs standardindata
fold-usage = fold [FLAGGA]... [FIL]...
fold-bytes-help = räkna byte i stället för kolumner (kontrolltecken som nyrad behandlas då inte särskilt)
fold-spaces-help = bryt rader vid ordgränser i stället för vid en fast teckenposition
fold-width-help = ange BREDD som största radbredd i stället för 80
fold-error-illegal-width = ogiltigt antal kolumner: { $width }
fold-error-readline = misslyckades med att läsa raden
fold-characters-help = räkna teckenpositioner i stället för visningskolumner
fold-error-width-out-of-range = ogiltigt antal kolumner: { $width }: numeriskt resultat utanför intervallet
