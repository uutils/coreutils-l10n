csplit-about = Divideix un fitxer en seccions determinades per línies de context
csplit-usage = csplit [OPCIÓ]… ARXIU PATRÓ…
csplit-after-help = Divideix trossos de FITXER separats per PATRÓ(ns) a fitxers "xx00", "xx01", …, i mostra el recompte de bytes de cada peça a la sortida estàndard.
csplit-help-suffix-format = utilitza sprintf FORMAT en comptes de %02d
csplit-help-prefix = utilitza PREFIX en comptes de "xx"
csplit-help-keep-files = no eliminis els fitxers de sortida en trobar errors
csplit-help-suppress-matched = silencia les línies coincidents amb PATRÓ
csplit-help-digits = utilitza el nombre de dígits especificats en comptes de 2
csplit-help-quiet = no mostris els recomptes de la mida dels arxius de sortida
csplit-help-elide-empty-files = esborra els fitxers de sortida buits
csplit-error-line-out-of-range = { $pattern }: numero de línia fora de rang
csplit-error-line-out-of-range-on-repetition = { $pattern }: numero de línia fora de rang en la repetició { $repetition }
csplit-error-match-not-found = { $pattern }: sense coincidència
csplit-error-match-not-found-on-repetition = { $pattern }: sense coincidència en la repetició { $repetition }
csplit-error-line-number-is-zero = 0: el numero de línia ha de ser superior a zero
csplit-error-line-number-smaller-than-previous = el numero de lnia "{ $current }" es menor al precedent, { $previous }
csplit-error-invalid-pattern = { $pattern }: patró invalid
csplit-error-invalid-number = numero invalid: { $number }
csplit-error-suffix-format-incorrect = especificació de conversió incorrecte en el sufix
csplit-error-suffix-format-too-many-percents = masses especificacions de conversió % en el sufix
csplit-error-not-regular-file = { $file } no es un arxiu regular
csplit-warning-line-number-same-as-previous = el numero de línia "{ $line_number }" es igual a l'anterior
csplit-read-error = error de lectura
csplit-write-split-not-created = intentant escriure una divisió que no ha estat creada
csplit-diag-help-pattern = un patró és un numero de línia N, /REGEXP/[DESPL] o %REGEXP%[DESPL], cada un seguit opcionalment per { "{" }N{ "}" } o { "{" }*{ "}" }
csplit-diag-help-line-number = els números de línia comencen per 1 i no poden decreixer d'un patró al següent
csplit-diag-help-digits = --digits pren un numero decimal de dígits, com -n 3
csplit-diag-help-suffix-format = un format de sufix es una conversió de printf per a un sencer no signat, com %03u
