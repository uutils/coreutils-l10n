mkdir-error-file-exists = { $path }: Afaylu-a yella yakan
mkdir-usage = mkdir [TAXTIṚT]... AKARAM...
mkdir-about = Snulfu-d AKARAM (neɣ ikaramen) i d-yettunefken ma ulac-iten
mkdir-after-help = Yal ASKAR yesɛa talɣa [ugoa]\*([-+=]\([rwxXst]\*|[ugo]))+|[-+=]?[0-7]+.
mkdir-help-mode = Sbadu askar n ufaylu (ur yettwaxdem ara deg Windows)
mkdir-help-parents = Snulfu-d ikaramen ibabaten ma ilaq
mkdir-help-verbose = Sken-d izen i yal akaram i d-yettwarnan
mkdir-help-selinux = Sbadu asatal n tɣellist SELinux n yal akaram i d-yettwarnan s wanaw amezwer
mkdir-help-context = Am -Z, neɣ ma yettwabder-d CTX, err asatal n tɣellist SELinux neɣ SMACK d CTX
mkdir-error-invalid-mode = Askar arameɣtu { $mode }
mkdir-error-empty-directory-name = Ur yezmir ara ad d-isnulfu akaram '': Ulac afaylu neɣ akaram s yisem-a
mkdir-error-failed-to-create-tree = Ur yezmir ara ad d-isnulfu aseklu ummid
mkdir-error-cannot-set-permissions = Ur yezmir ara ad isbadu tisirag n { $path }
mkdir-error-cannot-create-directory = Ur yezmir ara ad d-isnulfu akaram '{ $path }': { $error }
mkdir-verbose-created-directory = { $util_name }: Yettwarna-d ukaram { $path }
