env-about = Sätt varje NAMN till VÄRDE i miljön och kör KOMMANDO
env-usage = env [FLAGGA]... [-] [NAMN=VÄRDE]... [KOMMANDO [ARG]...]
env-after-help = Ett ensamt - innebär -i. Om inget KOMMANDO anges skrivs den resulterande miljön ut.
env-help-ignore-environment = börja med en tom miljö
env-help-chdir = byt arbetskatalog till KAT
env-help-null = avsluta varje utdatarad med en 0-byte i stället för en nyrad (gäller bara när miljön skrivs ut)
env-help-unset = ta bort variabel från miljön
env-help-debug = skriv utförlig information för varje bearbetningssteg
env-help-split-string = bearbeta och dela upp S i separata argument; används för att skicka flera argument i shebang-rader
env-help-argv0 = Åsidosätt det nollte argumentet som skickas till kommandot som körs. Utan denna flagga används standardvärdet `command`.
env-help-ignore-signal = låt hantering av signalerna SIG inte göra något
env-help-default-signal = återställ hantering av signalerna SIG till standardåtgärden
env-help-block-signal = blockera leverans av signalerna SIG medan KOMMANDO körs
env-help-list-signal-handling = lista ändringar av signalhanteringen som begärts med föregående flaggor
env-error-missing-closing-quote = avslutande citattecken saknas i -S-strängen vid position { $position } för citattecknet '{ $quote }'
env-error-invalid-backslash-at-end = ogiltigt omvänt snedstreck i slutet av strängen i -S vid position { $position } i sammanhanget { $context }
env-error-backslash-c-not-allowed = '\c' får inte förekomma i en -S-sträng inom dubbla citattecken vid position { $position }
env-error-invalid-sequence = ogiltig sekvens '\{ $char }' i -S vid position { $position }
env-error-missing-closing-brace = Avslutande klammerparentes saknas vid position { $position }
env-error-missing-variable = Variabelnamn saknas vid position { $position }
env-error-only-braced-variable = endast expansionen ${ VARNAME } stöds vid position { $position }
env-error-only-braced-variable-at = endast expansionen { "${VARNAME}" } stöds, fel vid: { $rest }
env-error-unexpected-number = Oväntat tecken: '{ $char }', det förväntade variabelnamnet får inte börja med 0..9 vid position { $position }
env-error-cannot-specify-null-with-command = det går inte att ange --null (-0) med ett kommando
env-error-invalid-signal = { $signal }: ogiltig signal
env-error-generic = Fel: { $error }
env-error-no-such-file = { $program }: Fil eller katalog saknas
env-error-use-s-shebang = använd -[v]S för att skicka flaggor i shebang-rader
env-error-cannot-unset = kan inte ta bort '{ $name }': Ogiltigt argument
env-error-cannot-unset-invalid = kan inte ta bort { $name }: Ogiltigt argument
env-error-must-specify-command-with-chdir = måste ange ett kommando med --chdir (-C)
env-error-cannot-change-directory = kan inte byta till katalogen { $directory }: { $error }
env-error-argv0-not-supported = --argv0 stöds för närvarande inte på denna plattform
env-error-failed-set-signal-action = kunde inte ange signalåtgärd för signalen { $signal }: { $error }
env-warning-no-name-specified = inget namn angavs för värdet { $value }
env-diag-label-variable-digit = ett variabelnamn kan inte börja med en siffra
env-diag-label-missing-brace = denna { "{" } har ingen avslutande klammerparentes
env-diag-help-quoting = -S använder citattecken som skalet: ' och " ska paras ihop och \' undantar ett citattecken
env-diag-help-backslash = ett omvänt snedstreck undantar tecknet efter det, så strängen kan inte avslutas med ett
env-diag-help-backslash-c = \c avslutar -S-strängen och saknar betydelse inom dubbla citattecken
env-diag-help-escape = -S hanterar \r, \n, \t, \f, \v, \_, \#, \$, \" och \c
env-diag-help-variable = endast $NAMN och ${ "{" }NAMN{ "}" } expanderas; de andra skalformerna stöds inte
