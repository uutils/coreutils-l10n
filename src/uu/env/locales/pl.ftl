env-about = Ustawia każdą NAZWĘ na WARTOŚĆ w środowisku i uruchamia POLECENIE
env-usage = env [OPCJA]... [-] [NAZWA=WARTOŚĆ]... [POLECENIE [ARG]...]
env-after-help = Samo - oznacza -i. Jeśli nie ma POLECENIA, wyświetla wynikowe środowisko.
env-help-ignore-environment = rozpoczyna od pustego środowiska
env-help-chdir = zmienia katalog roboczy na KAT
env-help-null = kończy każdy wiersz wyjściowy bajtem 0 zamiast znakiem nowego wiersza (dotyczy tylko wypisywania środowiska)
env-help-file = odczytuje i ustawia zmienne z pliku konfiguracyjnego w stylu „.env” (przed jakimkolwiek ustawieniem i/lub usunięciem ustawień)
env-help-unset = usuwa zmienną ze środowiska
env-help-debug = wypisuje szczegółowe informacje dla każdego kroku przetwarzania
env-help-split-string = przetwarza i dzieli S na osobne argumenty; używane do przekazywania wielu argumentów w wierszach shebang
env-help-argv0 = Nadpisuje zerowy argument przekazany do wykonywanego polecenia. Bez tej opcji używana jest domyślna wartość „command”.
env-help-ignore-signal = ustawia obsługę sygnału(-ów) SIG tak, aby nic nie robić
env-help-default-signal = przywraca obsługę sygnału(-ów) SIG do domyślnej czynności
env-help-block-signal = blokuje dostarczanie sygnału(-ów) SIG podczas wykonywania POLECENIA
env-help-list-signal-handling = wyświetla zmiany w obsłudze sygnału żądane przez poprzednie opcje
env-error-missing-closing-quote = brak końcowego cudzysłowu w ciągu -S na pozycji { $position } dla cudzysłowu '{ $quote }'
env-error-invalid-backslash-at-end = nieprawidłowy ukośnik odwrotny na końcu ciągu w -S na pozycji { $position } w kontekście { $context }
env-error-backslash-c-not-allowed = '\c' nie może występować w podwójnym cudzysłowie -S w pozycji { $position }
env-error-invalid-sequence = nieprawidłowa sekwencja '\{ $char }' w -S na pozycji { $position }
env-error-missing-closing-brace = Brak zamykającego nawiasu klamrowego na pozycji { $position }
env-error-missing-variable = Brak nazwy zmiennej na pozycji { $position }
env-error-only-braced-variable = obsługiwane jest tylko rozszerzenie ${ VARNAME } na pozycji { $position }
env-error-only-braced-variable-at = obsługiwane jest tylko rozszerzenie { "${VARNAME}" }, błąd w: { $rest }
env-error-unexpected-number = Nieoczekiwany znak: '{ $char }', oczekiwana nazwa zmiennej nie może zaczynać się od cyfr 0..9 na pozycji { $position }
env-error-cannot-specify-null-with-command = nie można określić --null (-0) w poleceniu
env-error-invalid-signal = { $signal }: nieprawidłowy sygnał
env-error-generic = Błąd: { $error }
env-error-no-such-file = { $program }: nie ma takiego pliku ani katalogu
env-error-use-s-shebang = używa -[v]S do przekazania opcji w wierszach shebang
env-error-cannot-unset = nie można usunąć ustawienia '{ $name }': nieprawidłowy argument
env-error-cannot-unset-invalid = nie można usunąć ustawienia { $name }: nieprawidłowy argument
env-error-must-specify-command-with-chdir = należy określić polecenie za pomocą --chdir (-C)
env-error-cannot-change-directory = nie można zmienić katalogu na { $directory }: { $error }
env-error-argv0-not-supported = --argv0 nie jest obecnie obsługiwany na tej platformie
env-error-failed-set-signal-action = nie udało się ustawić czynności sygnału dla sygnału { $signal }: { $error }
env-warning-no-name-specified = nie określono nazwy dla wartości { $value }
env-diag-label-variable-digit = nazwa zmiennej nie może zaczynać się od cyfry
env-diag-label-missing-brace = ten { "{" } nigdy nie jest zamknięty
env-diag-help-quoting = -S cytuje tak samo jak powłoka: znaki ' i " występują w parach, a znak \' pomija cudzysłów
env-diag-help-backslash = znak odwrotnego ukośnika powoduje pominięcie następującego po nim znaku, więc nie można zakończyć ciągu znaków
env-diag-help-backslash-c = \c kończy ciąg -S i nie ma znaczenia w cudzysłowie
env-diag-help-escape = -S rozumie \r, \n, \t, \f, \v, \_, \#, \$, \" i \c
env-diag-help-variable = tylko $NAME i ${ "{" }NAME{ "}" } są rozwijane; pozostałe formy powłoki nie są
